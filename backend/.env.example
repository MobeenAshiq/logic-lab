# --- App ---
NODE_ENV=development
PORT=4000
# Frontend origin (CORS + redirect target after Google login / email links)
FRONTEND_URL=http://localhost:3100
# Public URL of this API as the browser sees it. The frontend proxies /api/* to the API,
# so this is the frontend URL + /api (used for the Google OAuth callback).
API_URL=http://localhost:3100/api
# Proxies in front of the API (1 = the Next.js /api proxy) so rate limits use the real IP.
TRUST_PROXY=1

# --- Database (local docker-compose; in production use Supabase/Neon free Postgres) ---
DATABASE_URL=postgresql://logiclab:logiclab@localhost:5433/logiclab?schema=public

# --- AI (server-side only; choose gemini or groq) ---
AI_PROVIDER=gemini
# Optional model override. If omitted, the adapter uses its provider default.
AI_MODEL=
GEMINI_API_KEY=
GROQ_API_KEY=

# --- JWT (generate each with: openssl rand -base64 48) ---
JWT_ACCESS_SECRET=change-me-access-secret-at-least-32-chars
JWT_ACCESS_TTL_SECONDS=900
REFRESH_TTL_DAYS=30
# Set to true in production (HTTPS only cookies)
COOKIE_SECURE=false
# Encrypts TOTP secrets at rest (openssl rand -base64 48)
ENCRYPTION_KEY=change-me-encryption-key-at-least-32-chars

# --- Google OAuth (Google Cloud Console -> Credentials -> OAuth client ID) ---
# Authorized redirect URI: ${API_URL}/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Email (Resend). If RESEND_API_KEY is empty, emails are printed to the console. ---
RESEND_API_KEY=
EMAIL_FROM=LogicLab <onboarding@resend.dev>

# --- Rate limiting (Upstash Redis). If empty, an in-memory limiter is used (dev only). ---
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# --- File storage (Cloudflare R2, S3-compatible). Uploads return 503 until set. ---
# R2 -> Manage R2 API tokens -> Create token (Object Read & Write on the bucket)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=logiclab

# --- Seed: first super_admin (npm run seed) ---
SUPER_ADMIN_EMAIL=admin@logiclab.pk
SUPER_ADMIN_PASSWORD=ChangeMe!12345
SUPER_ADMIN_NAME=LogicLab Admin
